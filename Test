    async function sendMessage() {
    const userInput = document.getElementById("userInput").value;
    const responseContainer = document.getElementById("responseContainer");
  
    responseContainer.innerHTML = "Thinking...";
  
    try {
      const response = await fetch("http://127.0.0.1:8000/chat/", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ message: userInput })
      });
  
      const data = await response.json();
  
      if (data.response) {
        responseContainer.innerHTML = `<strong>Chatbot:</strong> ${data.response}`;
      } else {
        responseContainer.innerHTML = `<strong>Error:</strong> ${data.error || "Something went wrong."}`;
      }
    } catch (err) {
      responseContainer.innerHTML = `<strong>Error:</strong> ${err.message}`;
    }
  }

  // Typewriter effect function
function typeText(element, text, speed = 30) {
    element.innerHTML = "";
    let index = 0;
  
    function type() {
      if (index < text.length) {
        element.scrollIntoView({ behavior: 'smooth', block: 'end' });
        element.innerHTML += text.charAt(index);
        index++;
        setTimeout(type, speed);
      }
    }
  
    type();
  }