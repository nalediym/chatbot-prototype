class MessageRequest(BaseModel):
    message: str


@app.post("/chat/")
async def chat(request: MessageRequest):
    user_message = request.message
    #custom_content = fetch_custom_content(rquest.url)
# Combine custom instructions with user message
    system_prompt = f"""You are a helpful assistant that responds on behalf of the IT Senior Management Forum (ITSMF). 
Use only the tone and information aligned with ITSMF's mission, programs, and professional development content.
Here are your instructions and knowledge base:


{CUSTOM_INSTRUCTIONS}
"""

    try:
        #response = openai.ChatCompletion.create ( 
        response = openai.client.chat.completions.create ( 

            model="gpt-4",
            messages=[
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_message},
            ],
            temperature=0.7,
        )

        reply = response['choices'][0]['message']['content']
        return {"response": reply}
    except Exception as e:
        return {"error": str(e)}





